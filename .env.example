APP_ID=12345678
APP_HASH=your_app_hash_here

PHONE=+628xxxxxxxxxx

SESSION_FILE=data/session.json
DATABASE_PATH=data/goultroid.db

PREFIX=.

OWNER_ID=123456789
SUDO_USERS=

# Optional external service used by the .ocr plugin.
# Get a key from OCR.Space and keep it out of source control.
OCR_API=

LOG_LEVEL=info

# Execution runtime. TASKENGINE_POOLS is the complete configured pool set.
# MAX is the hard worker bound; MIN workers remain warm. PAYLOAD_BYTES bounds
# queued payload memory per pool, and IDLE_TIMEOUT is a Go duration (30s, 1m).
TASKENGINE_POOLS=general,interactive,download,media-process,scheduler

TASKENGINE_POOL_GENERAL_MIN=1
TASKENGINE_POOL_GENERAL_MAX=8
TASKENGINE_POOL_GENERAL_BACKLOG=200
TASKENGINE_POOL_GENERAL_PAYLOAD_BYTES=104857600
TASKENGINE_POOL_GENERAL_IDLE_TIMEOUT=30s

TASKENGINE_POOL_INTERACTIVE_MIN=2
TASKENGINE_POOL_INTERACTIVE_MAX=32
TASKENGINE_POOL_INTERACTIVE_BACKLOG=128
TASKENGINE_POOL_INTERACTIVE_PAYLOAD_BYTES=52428800
TASKENGINE_POOL_INTERACTIVE_IDLE_TIMEOUT=30s

TASKENGINE_POOL_DOWNLOAD_MIN=1
TASKENGINE_POOL_DOWNLOAD_MAX=3
TASKENGINE_POOL_DOWNLOAD_BACKLOG=50
TASKENGINE_POOL_DOWNLOAD_PAYLOAD_BYTES=209715200
TASKENGINE_POOL_DOWNLOAD_IDLE_TIMEOUT=45s

TASKENGINE_POOL_MEDIA_PROCESS_MIN=1
TASKENGINE_POOL_MEDIA_PROCESS_MAX=2
TASKENGINE_POOL_MEDIA_PROCESS_BACKLOG=20
TASKENGINE_POOL_MEDIA_PROCESS_PAYLOAD_BYTES=209715200
TASKENGINE_POOL_MEDIA_PROCESS_IDLE_TIMEOUT=1m

TASKENGINE_POOL_SCHEDULER_MIN=1
TASKENGINE_POOL_SCHEDULER_MAX=4
TASKENGINE_POOL_SCHEDULER_BACKLOG=100
TASKENGINE_POOL_SCHEDULER_PAYLOAD_BYTES=52428800
TASKENGINE_POOL_SCHEDULER_IDLE_TIMEOUT=1m

# Coordinator/result/memory/delivery limits. Duration values use Go duration syntax.
TASKENGINE_RESULT_CAPACITY=1000
TASKENGINE_MAX_TERMINAL=1000
TASKENGINE_DECISION_TIMEOUT=5s
TASKENGINE_INBOX_CAPACITY=2048
TASKENGINE_MAX_RETAINED_BYTES=268435456
TASKENGINE_MAX_OUTPUT_BYTES=1048576
TASKENGINE_MAX_FAILURE_BYTES=4096
TASKENGINE_DELIVERY_CONCURRENCY=4
# 0 means use the runtime default max(ResultCapacity, 256).
TASKENGINE_DELIVERY_QUEUE_CAP=0
# 0s disables TTL-based terminal eviction; count/byte eviction still applies.
TASKENGINE_TERMINAL_TTL=0s
TASKENGINE_MAX_SCOPE_TOMBSTONES=4096
# Dedicated workers that execute durable commit callbacks.
TASKENGINE_DURABILITY_CONCURRENCY=4

# Dispatch-time shared resource reservations.
TASKENGINE_RESOURCE_CAPACITIES=process=2,media=2,download=3

# Backward-compatible aliases are still accepted when loading old .env files:
# TASKENGINE_RETAINED_MB and TASKENGINE_POOL_<POOL>_IDLE_SECONDS.
