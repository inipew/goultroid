APP_ID=12345678
APP_HASH=your_app_hash_here

PHONE=+628xxxxxxxxxx

SESSION_FILE=data/session.json
DATABASE_PATH=data/goultroid.db

PREFIX=.

OWNER_ID=123456789
SUDO_USERS=

# Optional external service used by the .ocr plugin.
# Get a key from OCR.Space and keep it out of source control.
OCR_API=

LOG_LEVEL=info

# Execution runtime. MAX is a hard bound; MIN workers remain warm and the
# pool scales between MIN..MAX, retiring excess workers after IDLE_SECONDS.
TASKENGINE_POOL_GENERAL_MIN=1
TASKENGINE_POOL_GENERAL_MAX=8
TASKENGINE_POOL_GENERAL_IDLE_SECONDS=30
TASKENGINE_POOL_INTERACTIVE_MIN=2
TASKENGINE_POOL_INTERACTIVE_MAX=32
TASKENGINE_POOL_INTERACTIVE_IDLE_SECONDS=30
TASKENGINE_POOL_DOWNLOAD_MIN=1
TASKENGINE_POOL_DOWNLOAD_MAX=3
TASKENGINE_POOL_MEDIA_PROCESS_MIN=1
TASKENGINE_POOL_MEDIA_PROCESS_MAX=2
TASKENGINE_POOL_SCHEDULER_MIN=1
TASKENGINE_POOL_SCHEDULER_MAX=4
TASKENGINE_RETAINED_MB=256
TASKENGINE_RESULT_CAPACITY=1000
TASKENGINE_MAX_TERMINAL=1000
TASKENGINE_RESOURCE_CAPACITIES=process=2,media=2,download=3
